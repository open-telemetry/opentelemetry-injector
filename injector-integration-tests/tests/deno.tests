# Deno reads NODE_OPTIONS for compatibility with Node.js. The injector must not add the Node.js auto-instrumentation to
# it, see https://github.com/open-telemetry/opentelemetry-injector/issues/458. The test app runs without --allow-read,
# like the Deno application that crashed in that issue.

run_test_case \
  "does not add NODE_OPTIONS to a Deno process" \
  "app" \
  "deno run --allow-env main.js node-options" \
  "NODE_OPTIONS: -"
run_test_case \
  "does not modify existing NODE_OPTIONS of a Deno process" \
  "app" \
  "deno run --allow-env main.js node-options" \
  "NODE_OPTIONS: --no-deprecation" \
  "NODE_OPTIONS=--no-deprecation"
run_test_case \
  "does not load the Node.js auto-instrumentation agent into a Deno process" \
  "app" \
  "deno run --allow-env main.js verify-auto-instrumentation-agent-has-been-injected" \
  "otel_injector_nodejs_no_op_agent_has_been_loaded: -"
run_test_case \
  "sets OTEL_RESOURCE_ATTRIBUTES for a Deno process" \
  "app" \
  "deno run --allow-env main.js otel-resource-attributes" \
  "OTEL_RESOURCE_ATTRIBUTES: k8s.namespace.name=my-namespace,k8s.pod.name=my-pod,k8s.pod.uid=275ecb36-5aa8-4c2a-9c47-d8bb681b9aff,k8s.container.name=test-app"
