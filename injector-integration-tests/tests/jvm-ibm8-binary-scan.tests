# shellcheck shell=sh

# Copyright The OpenTelemetry Authors
# SPDX-License-Identifier: Apache-2.0

# The jvm-ibm8 test set, in an image whose classlib.properties has no version entry (see apps/jvm/Dockerfile), so
# that the injector has to detect the Java version by scanning the VM binary.

# Should the image still carry the version entry, the injector would read it instead, and every case below would pass
# without reaching the scanner. The debug log is the only place that tells the two apart.
run_test_case \
  "detects the Java version by scanning the VM binary" \
  "app" \
  "java -version 2>&1 | grep -m 1 -o 'JVM detection: scanning'" \
  "JVM detection: scanning" \
  "OTEL_INJECTOR_LOG_LEVEL=debug"

# shellcheck source=injector-integration-tests/tests/jvm-ibm8.tests
. tests/jvm-ibm8.tests
