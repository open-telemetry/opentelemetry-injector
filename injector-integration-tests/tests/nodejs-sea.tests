# Tests for a Node.js single executable application (SEA), see injector-integration-tests/apps/nodejs-sea/Dockerfile.
# The SEA is a modified copy of the node executable, so the injector recognizes it as Node.js like the node executable
# itself. On glibc, its program header table is at an address that is not 8 byte aligned.

if [ "${LIBC_FLAVOR:-}" = "musl" ] && [ "$(uname -m)" = "aarch64" ]; then
  # postject rebuilds the GNU hash table of the musl builds of Node.js. On arm64, the rebuilt table finds no symbols at
  # all, its bloom filter rejects every one of them: neither the injector nor the dynamic linker can look up the symbols
  # of the executable (native addons fail to load with "symbol not found" as well). The injector therefore does not
  # recognize the SEA as Node.js. This test case makes sure that it at least does not break the process. On x86_64, the
  # rebuilt table works, and the SEA is recognized like on glibc.
  run_test_case \
    "SEA (musl, arm64): is not recognized as Node.js, and runs without NODE_OPTIONS" \
    "app" \
    "./app-sea node-options" \
    "NODE_OPTIONS: -"
  # The injector is still loaded into the SEA process: it sets OTEL_RESOURCE_ATTRIBUTES. Without this check, the test
  # case above would also pass if the injector did not run at all.
  run_test_case \
    "SEA (musl, arm64): sets OTEL_RESOURCE_ATTRIBUTES" \
    "app" \
    "./app-sea otel-resource-attributes" \
    "OTEL_RESOURCE_ATTRIBUTES: k8s.namespace.name=my-namespace,k8s.pod.name=my-pod,k8s.pod.uid=275ecb36-5aa8-4c2a-9c47-d8bb681b9aff,k8s.container.name=test-app"
  return 0 2>/dev/null || true
fi

run_test_case \
  "SEA: injects NODE_OPTIONS if it is not present" \
  "app" \
  "./app-sea node-options" \
  "NODE_OPTIONS: --require /usr/lib/opentelemetry/nodejs/node_modules/@opentelemetry/auto-instrumentations-node/dist/register.cjs"
run_test_case \
  "SEA: prepends to NODE_OPTIONS if it is present" \
  "app" \
  "./app-sea node-options" \
  "NODE_OPTIONS: --require /usr/lib/opentelemetry/nodejs/node_modules/@opentelemetry/auto-instrumentations-node/dist/register.cjs --no-deprecation" \
  "NODE_OPTIONS=--no-deprecation"
run_test_case \
  "SEA: injects the Node.js auto-instrumentation agent" \
  "app" \
  "./app-sea verify-auto-instrumentation-agent-has-been-injected" \
  "otel_injector_nodejs_no_op_agent_has_been_loaded: true"
run_test_case \
  "SEA: sets OTEL_RESOURCE_ATTRIBUTES" \
  "app" \
  "./app-sea otel-resource-attributes" \
  "OTEL_RESOURCE_ATTRIBUTES: k8s.namespace.name=my-namespace,k8s.pod.name=my-pod,k8s.pod.uid=275ecb36-5aa8-4c2a-9c47-d8bb681b9aff,k8s.container.name=test-app"
