run_test_case \
  "injects NODE_OPTIONS if it is not present" \
  "app" \
  "node index.js node-options" \
  "NODE_OPTIONS: --require /usr/lib/opentelemetry/nodejs/node_modules/@opentelemetry/auto-instrumentations-node/dist/register.cjs"
run_test_case \
  "ask for NODE_OPTIONS (unset) twice" \
  "app" \
  "node index.js node-options-twice" \
  "NODE_OPTIONS: --require /usr/lib/opentelemetry/nodejs/node_modules/@opentelemetry/auto-instrumentations-node/dist/register.cjs; NODE_OPTIONS: --require /usr/lib/opentelemetry/nodejs/node_modules/@opentelemetry/auto-instrumentations-node/dist/register.cjs"
run_test_case \
  "prepends to NODE_OPTIONS if it is present" \
  "app" \
  "node index.js node-options" \
  "NODE_OPTIONS: --require /usr/lib/opentelemetry/nodejs/node_modules/@opentelemetry/auto-instrumentations-node/dist/register.cjs --no-deprecation" \
  "NODE_OPTIONS=--no-deprecation"
run_test_case \
  "ask for NODE_OPTIONS (set) twice" \
  "app" \
  "node index.js node-options-twice" \
  "NODE_OPTIONS: --require /usr/lib/opentelemetry/nodejs/node_modules/@opentelemetry/auto-instrumentations-node/dist/register.cjs --no-deprecation; NODE_OPTIONS: --require /usr/lib/opentelemetry/nodejs/node_modules/@opentelemetry/auto-instrumentations-node/dist/register.cjs --no-deprecation" \
  "NODE_OPTIONS=--no-deprecation"

run_test_case \
  "injects the Node.js auto-instrumentation agent" \
  "app" \
  "node index.js verify-auto-instrumentation-agent-has-been-injected" \
  "otel_injector_nodejs_no_op_agent_has_been_loaded: true"

# For test cases with the "default configuration file" substring in their label, run-tests-within-container.sh
# will provide a configuration file in the default location (/etc/opentelemetry/injector/injector.conf).
run_test_case \
  "uses NODE_OPTIONS path from the default configuration file" \
  "app" \
  "node index.js node-options" \
  "NODE_OPTIONS: --require /path/from/config-file/nodejs/node_modules/@opentelemetry/auto-instrumentations-node/dist/register.cjs"
run_test_case \
  "the NODEJS_AUTO_INSTRUMENTATION_AGENT_PATH environment variable overrides the NODE_OPTIONS path from the default configuration file" \
  "app" \
  "node index.js node-options" \
  "NODE_OPTIONS: --require /path/from/environment-variable/nodejs/node_modules/@opentelemetry/auto-instrumentations-node/dist/register.cjs" \
  "NODEJS_AUTO_INSTRUMENTATION_AGENT_PATH=/path/from/environment-variable/nodejs/node_modules/@opentelemetry/auto-instrumentations-node/dist/register.cjs"

run_test_case \
  "uses NODE_OPTIONS path from the configuration file at a custom location" \
  "app" \
  "node index.js node-options" \
  "NODE_OPTIONS: --require /path/from/config-file-custom-location/nodejs/node_modules/@opentelemetry/auto-instrumentations-node/dist/register.cjs" \
  "OTEL_INJECTOR_CONFIG_FILE=/custom/config/path/injector.conf"
run_test_case \
  "the NODEJS_AUTO_INSTRUMENTATION_AGENT_PATH environment variable overrides the NODE_OPTIONS path from the configuration file at a custom location" \
  "app" \
  "node index.js node-options" \
  "NODE_OPTIONS: --require /path/from/environment-variable/nodejs/node_modules/@opentelemetry/auto-instrumentations-node/dist/register.cjs" \
  "OTEL_INJECTOR_CONFIG_FILE=/custom/config/path/injector.conf NODEJS_AUTO_INSTRUMENTATION_AGENT_PATH=/path/from/environment-variable/nodejs/node_modules/@opentelemetry/auto-instrumentations-node/dist/register.cjs"

run_test_case \
  "setting OTEL_INJECTOR_AUTO_INSTRUMENTATION_DISABLED=nodejs disables the Node.js auto-instrumentation" \
  "app" \
  "node index.js node-options" \
  "NODE_OPTIONS: -" \
  "OTEL_INJECTOR_AUTO_INSTRUMENTATION_DISABLED=nodejs"
run_test_case \
  "setting OTEL_INJECTOR_AUTO_INSTRUMENTATION_DISABLED=* disables the Node.js auto-instrumentation" \
  "app" \
  "node index.js node-options" \
  "NODE_OPTIONS: -" \
  "OTEL_INJECTOR_AUTO_INSTRUMENTATION_DISABLED=*"
run_test_case \
  "setting NODEJS_AUTO_INSTRUMENTATION_AGENT_PATH to the empty string disables the Node.js auto-instrumentation" \
  "app" \
  "node index.js node-options" \
  "NODE_OPTIONS: -" \
  "NODEJS_AUTO_INSTRUMENTATION_AGENT_PATH="

run_test_case \
  "OTEL_ custom env var is returned according to the env file provided" \
  "app" \
  "node index.js custom-env-var OTEL_SDK_DISABLED" \
  "OTEL_SDK_DISABLED: true"

run_test_case \
  "non OTEL_ custom env var is ignored" \
  "app" \
  "node index.js custom-env-var CUSTOM_ENV_VAR" \
  "CUSTOM_ENV_VAR: -"

run_test_case \
  "setting OTEL_INJECTOR_DISABLED to true string disables the Node.js auto-instrumentation" \
  "app" \
  "node index.js node-options" \
  "NODE_OPTIONS: -" \
  "OTEL_INJECTOR_DISABLED=TRUE OTEL_INJECTOR_LOG_LEVEL=info"

# NODE_OPTIONS is only set for Node.js processes. A shell is not Node.js, but when it starts a Node.js process, that
# process loads the injector via LD_PRELOAD as well, and gets NODE_OPTIONS from it.
run_test_case \
  "does not add NODE_OPTIONS to a process that is not Node.js" \
  "app" \
  "sh -c 'echo NODE_OPTIONS: \${NODE_OPTIONS:--}'" \
  "NODE_OPTIONS: -"
run_test_case \
  "injects NODE_OPTIONS into a Node.js process started from a shell" \
  "app" \
  "sh -c 'node index.js node-options'" \
  "NODE_OPTIONS: --require /usr/lib/opentelemetry/nodejs/node_modules/@opentelemetry/auto-instrumentations-node/dist/register.cjs"

# Package managers are Node.js applications themselves, and run scripts via a shell. NODE_OPTIONS reaches the Node.js
# process at the end of the chain twice: inherited from the package manager's environment, and from the injector
# running in the process itself. The --require must still be there only once.
run_test_case \
  "injects NODE_OPTIONS once into a Node.js process started via npm run" \
  "app" \
  "npm run --silent node-options" \
  "NODE_OPTIONS: --require /usr/lib/opentelemetry/nodejs/node_modules/@opentelemetry/auto-instrumentations-node/dist/register.cjs"
run_test_case \
  "injects NODE_OPTIONS once into a Node.js process started via nested npm run" \
  "app" \
  "npm run --silent nested-node-options" \
  "NODE_OPTIONS: --require /usr/lib/opentelemetry/nodejs/node_modules/@opentelemetry/auto-instrumentations-node/dist/register.cjs"
run_test_case \
  "injects the Node.js auto-instrumentation agent into a Node.js process started via npm run" \
  "app" \
  "npm run --silent verify-auto-instrumentation-agent-has-been-injected" \
  "otel_injector_nodejs_no_op_agent_has_been_loaded: true"
run_test_case \
  "injects NODE_OPTIONS once into a Node.js process started via npx" \
  "app" \
  "npx --no-install node index.js node-options" \
  "NODE_OPTIONS: --require /usr/lib/opentelemetry/nodejs/node_modules/@opentelemetry/auto-instrumentations-node/dist/register.cjs"
run_test_case \
  "injects NODE_OPTIONS once into a Node.js process started via yarn run" \
  "app" \
  "yarn --silent run node-options" \
  "NODE_OPTIONS: --require /usr/lib/opentelemetry/nodejs/node_modules/@opentelemetry/auto-instrumentations-node/dist/register.cjs"

# A process that is not Node.js inherits NODE_OPTIONS with the --require flag from its Node.js parent process, and the
# injector removes the flag again. The spawn command runs the given command via /bin/sh (like an npm script does), so
# the shell is the process that is not Node.js.
run_test_case \
  "removes the inherited --require from NODE_OPTIONS in a shell started by a Node.js process" \
  "app" \
  "node index.js spawn 'echo NODE_OPTIONS: \${NODE_OPTIONS:--}'" \
  "NODE_OPTIONS: -"
run_test_case \
  "injects NODE_OPTIONS again into a Node.js process started by a shell started by a Node.js process" \
  "app" \
  "node index.js spawn 'node index.js node-options'" \
  "NODE_OPTIONS: --require /usr/lib/opentelemetry/nodejs/node_modules/@opentelemetry/auto-instrumentations-node/dist/register.cjs"
